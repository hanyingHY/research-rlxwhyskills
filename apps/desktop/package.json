{
  "name": "opendirector-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "OpenDirector desktop shell: hosts the same web workspace and the bundled local API.",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "start": "npm run build && electron .",
    "dist:win": "node scripts/build-windows.mjs",
    "dist:dir": "node scripts/build-windows.mjs --dir"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "typescript": "5.8.3"
  }
}
